{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blend Stack",
  "version": "0.1.3",
  "identifier": "io.github.ilumetric.blendstack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blend Stack",
        "width": 1100,
        "height": 720,
        "minWidth": 520,
        "minHeight": 580,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Launcher for official Blender builds",
    "longDescription": "Blend Stack downloads, organizes and launches official Blender releases, daily builds and experimental builds.",
    "copyright": "Copyright (c) 2026 Max Derksen. Not affiliated with the Blender Foundation.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
